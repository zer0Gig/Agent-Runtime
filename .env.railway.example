# ── Railway Environment Variables ───────────────────────────────
# Set these in Railway Dashboard → Variables (copy-paste each key)
# ⚠️ NEVER commit this file with real values to git

# ── 0G Network ───────────────────────────────────────
OG_NEWTON_RPC=https://evmrpc-testnet.0g.ai
CHAIN_ID=16602

# ── Agent Wallet ─────────────────────────────────────
# Private key WITHOUT 0x prefix (single-agent Path A fallback)
AGENT_PRIVATE_KEY=your_agent_private_key_without_0x
AGENT_ID=1

# ── ECIES Keypair (per-agent encryption) ─────────────
AGENT_ECIES_PRIVATE_KEY=your_ecies_private_key_hex
AGENT_ECIES_PUBLIC_KEY=your_ecies_public_key_hex

# ── Contract Addresses (Newton testnet — 2026-04-28 deployment) ──
AGENT_REGISTRY_ADDRESS=0x4c49D008E72eF1E098Bcd6E75857Ed17377dB4ab
PROGRESSIVE_ESCROW_ADDRESS=0xe9d1d260c08385b3beB68012D425e208b4cd2295
SUBSCRIPTION_ESCROW_ADDRESS=0x088400FFf9d37851173e22eef904e710B88F6312
USER_REGISTRY_ADDRESS=0x1958bdbb5926674026b9ac630c9A4Cb91718Aee7

# ── 0G Storage ──────────────────────────────────────
OG_STORAGE_RPC=https://rpc-storage-testnet.0g.ai
OG_INDEXER_RPC=https://indexer-storage-testnet-turbo.0g.ai

# ── 0G Alignment Node Verification ───────────────────
# Deployer wallet private key (for demo self-signing)
ALIGNMENT_VERIFIER_KEY=your_deployer_private_key

# ── Platform Dispatcher (Path B) ─────────────────────
# Required when running `npm run start:platform` (which railway.toml uses)
PLATFORM_PRIVATE_KEY=your_platform_operator_private_key
PLATFORM_AGENT_IDS=2

# Per-agent signer keys for releaseMilestone. Format: "agentId:privKey,agentId:privKey"
AGENT_WALLET_KEYS=2:your_agent_2_private_key

# ── Demo / Alignment Configuration ───────────────────
# DEMO MODE: auto-approve all milestones (hackathon only — set false for production)
AUTO_APPROVE_MILESTONES=true

# Alignment auto-release threshold (basis points: 7500 = 75%).
# Only used when AUTO_APPROVE_MILESTONES=false.
ALIGNMENT_AUTO_APPROVE_THRESHOLD=7500
ALIGNMENT_GRACE_PERIOD_MS=60000

# Alignment score for demo mode (must be >= 8000)
DEMO_ALIGNMENT_SCORE=8500

# ── 0G Compute Network ────────────────────────────────
OG_COMPUTE_LEDGER_DEPOSIT=3
OG_COMPUTE_PROVIDER_DEPOSIT=1

# ── LLM Provider ─────────────────────────────────────
# Primary: 0g-compute (decentralized, needs 4+ OG in wallet)
# Fallback: groq (fastest, no OG needed)
FALLBACK_LLM_PROVIDER=groq

# ── LLM API Keys ─────────────────────────────────────
GROQ_API_KEY=your_groq_api_key
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
GOOGLE_API_KEY=your_google_api_key
ALIBABA_API_KEY=your_alibaba_api_key
OPENROUTER_API_KEY=your_openrouter_api_key

# ── Supabase (Skills Registry + Bot Config) ──────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
# Service role key REQUIRED for CustomerServiceBot (bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ── Frontend Integration ──────────────────────────────
# URL of your deployed Vercel frontend
ACTIVITY_LOG_URL=https://your-frontend.vercel.app/api/agent-activity
FRONTEND_URL=https://your-frontend.vercel.app

# ── Auth Token (agent ↔ frontend) ────────────────────
# Generate with: openssl rand -hex 32
# Set the SAME value in frontend env vars
AGENT_RUNTIME_TOKEN=your_random_hex_token

# ── ECIES Platform Encryption ────────────────────────
# Run `node src/setup-encryption-keys.js` locally to generate.
# Private key stays in runtime ONLY. Public key goes to frontend .env.local.
PLATFORM_ENCRYPTION_PRIVATE_KEY=your_platform_ecies_private_key

# ── Telegram Bot (optional) ──────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# Production webhook (uncomment if using webhook instead of polling):
# TELEGRAM_WEBHOOK_URL=https://your-railway-url.railway.app
# TELEGRAM_WEBHOOK_SECRET=your_webhook_secret_token

# ── 0G KV Node (optional — local only) ──────────────
OG_KV_NODE_RPC=http://localhost:6789
